# Copy to .env and adjust if needed

# --- Docker Compose (recommended) ---
# DATABASE_URL is set in docker-compose.yml — no change needed for container app.
# To connect from host tools (pgAdmin, DBeaver): localhost:5432

# --- Local venv without Docker ---
# PostgreSQL on host:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/email_spam_classification

# Quick dev without PostgreSQL:
# DATABASE_URL=sqlite:///email_spam_classification.db

MODEL_DIR=saved_models
FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Docker entrypoint: seed sample dataset on first start
SEED_DATASET=true
